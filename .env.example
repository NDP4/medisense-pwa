# Supabase Configuration (wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-here   # dari Settings > API di Dashboard

# PostgreSQL direct connection (hanya untuk migration — butuh IPv6)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase Personal Access Token (untuk CLI/Management API — butuh IPv4)
SUPABASE_ACCESS_TOKEN=sbp_your-pat-here                  # dari app.supabase.com/account/tokens

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (opsional, untuk asset upload)
BLOB_READ_WRITE_TOKEN=
